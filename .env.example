# ===== Grafana admin =====
GF_ADMIN_USER=admin
GF_ADMIN_PASSWORD=change_me_in_production

# ===== Grafana external URL (за reverse-proxy) =====
GF_SERVER_ROOT_URL=http://localhost:3000/
GF_SERVER_DOMAIN=localhost

# ===== Alerting: email =====
# На этот адрес будут уходить уведомления (contact-points.yaml → $__env{GF_ALERT_EMAIL})
GF_ALERT_EMAIL=alerts@example.com

# ===== SMTP (включается только при GF_SMTP_ENABLED=true) =====
GF_SMTP_ENABLED=false
GF_SMTP_HOST=smtp.gmail.com:587
GF_SMTP_USER=your-email@gmail.com
GF_SMTP_PASSWORD=your-app-password
GF_SMTP_FROM_ADDRESS=your-email@gmail.com
GF_SMTP_FROM_NAME=Grafana Monitoring
GF_SMTP_SKIP_VERIFY=true

# ===== Telegram (опционально) =====
# GF_TG_BOT_TOKEN=
# GF_TG_CHAT_ID=
